{
  "name": "cluster-terminal",
  "productName": "Cluster Terminal",
  "version": "1.2.0",
  "description": "Six Claude Code agents working together in one retro terminal.",
  "main": "main.js",
  "author": {
    "name": "coltonr100",
    "email": "coltonr100@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/coltonr100/Cluster-Terminal-Public",
  "repository": {
    "type": "git",
    "url": "https://github.com/coltonr100/Cluster-Terminal-Public.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.coltonr100.clusterterminal",
    "productName": "Cluster Terminal",
    "artifactName": "Cluster-Terminal-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "orchestrator.js",
      "checks.js",
      "mcp-bridge.js",
      "hook-guard.js",
      "demo.js",
      "renderer/**/*",
      "icon.ico",
      "icon.png"
    ],
    "asarUnpack": [
      "mcp-bridge.js",
      "hook-guard.js"
    ],
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cluster Terminal"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Development",
      "maintainer": "coltonr100 <coltonr100@users.noreply.github.com>"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
